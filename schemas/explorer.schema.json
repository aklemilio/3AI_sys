{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explorer",
  "title": "Salida del papel explorador (skills/explorer/SKILL.md)",
  "type": "object",
  "required": ["no_intervention_scenario", "options"],
  "properties": {
    "no_intervention_scenario": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "what_is_lost": {"type": "array", "items": {"type": "string"}},
        "what_value_remains": {"type": "array", "items": {"type": "string"}},
        "support": {"type": "array", "items": {"$ref": "#/$defs/support"}}
      }
    },
    "faces_found": {
      "type": "array",
      "items": {"type": "object", "required": ["face"], "properties": {"face": {"type": "string"}, "what_it_requires": {"type": "string"}}}
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "technique", "chain_stage", "depends_on_ai"],
        "properties": {
          "id": {"type": "string", "pattern": "^O[0-9]+$"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "technique": {"type": "string", "pattern": "^T[1-7]$"},
          "chain_stage": {"type": "string", "minLength": 1},
          "scale": {"type": "string"},
          "depends_on_ai": {"type": "boolean"},
          "actors": {"type": "array", "items": {"type": "string"}},
          "who_benefits": {"type": "array", "items": {"type": "string"}},
          "who_could_be_left_out": {"type": "array", "items": {"type": "string"}},
          "faces_affected": {"type": "array", "items": {"type": "string"}},
          "what_would_make_it_fail": {"type": "string"},
          "support": {"type": "array", "items": {"$ref": "#/$defs/support"}}
        }
      }
    }
  },
  "$defs": {
    "support": {
      "type": "object",
      "required": ["type", "claim"],
      "properties": {
        "type": {"enum": ["source", "reasoning", "position"]},
        "claim": {"type": "string"},
        "url": {"type": "string"},
        "fragment": {"type": "string"},
        "premises": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "source"}}},
         "then": {"required": ["url", "fragment"], "properties": {"url": {"minLength": 1}, "fragment": {"minLength": 1}}}}
      ]
    }
  }
}
