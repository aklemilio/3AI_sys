{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "screener",
  "title": "Salida del papel cribador (skills/screener/SKILL.md)",
  "type": "object",
  "required": ["assessments"],
  "properties": {
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fatal", "scores"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "fatal": {"type": "boolean"},
          "fatal_reason": {"type": "string"},
          "support": {"type": "array", "items": {"$ref": "#/$defs/support"}},
          "rescue": {"type": "string"},
          "scores": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 5}
          },
          "note": {"type": "string"}
        },
        "allOf": [
          {"if": {"properties": {"fatal": {"const": true}}, "required": ["fatal"]},
           "then": {"required": ["fatal_reason", "support", "rescue"],
                    "properties": {"fatal_reason": {"minLength": 1}, "support": {"minItems": 1}, "rescue": {"minLength": 1}}}}
        ]
      }
    },
    "new_options": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "builds_on": {"type": "array", "items": {"type": "string"}},
          "depends_on_ai": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "support": {
      "type": "object",
      "required": ["type", "claim"],
      "properties": {
        "type": {"enum": ["source", "reasoning"]},
        "claim": {"type": "string"},
        "url": {"type": "string"},
        "fragment": {"type": "string"},
        "premises": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "source"}}},
         "then": {"required": ["url", "fragment"], "properties": {"url": {"minLength": 1}, "fragment": {"minLength": 1}}}}
      ]
    }
  }
}
